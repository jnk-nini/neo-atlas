# Copy to .env.local for local development (never commit .env.local).
# The dev server and the Vercel function both read these; neither is sent to the browser.

# Where the AegisNEO API runs: the live API by default.
AEGISNEO_API_URL=https://aegisneo-api.vercel.app

# This site's own partner key: the "neo-atlas" entry of AEGISNEO_API_KEYS on the API project.
# Ask the project owner for it. The old public demo key no longer works, and a real key
# must never be committed (.env.local is ignored by git). Without a key the site shows
# an error instead of data.
AEGISNEO_API_KEY=
