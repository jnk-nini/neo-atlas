# Copy to .env.local for local development (never commit .env.local).
# The dev server and the Vercel function both read these; neither is sent to the browser.

# Where the AegisNEO API runs: the live API by default.
AEGISNEO_API_URL=https://aegisneo-api.vercel.app

# A key the API accepts. The public demo key works for local development;
# the live site uses its own key, set in Vercel (see AEGISNEO_API_KEYS on the API project).
AEGISNEO_API_KEY=student-api-key-123
